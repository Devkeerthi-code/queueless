# Copy to .env and fill in. Never commit .env.

# Postgres connection string. On Neon use the pooled connection string
# (host contains "-pooler") with sslmode=require.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Optional: a separate database for `npm test`. If unset, integration tests use
# DATABASE_URL but only touch throwaway "TEST canteen" rows they create and delete.
# TEST_DATABASE_URL=""

# Secret used to sign pickup QR codes (HMAC-SHA256). At least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it invalidates QR codes already shown to students (tokens still work).
QR_SECRET=""

# Bearer token Vercel Cron sends to /api/cron/no-shows. At least 16 characters.
# Vercel sets the Authorization header automatically when this env var is named CRON_SECRET.
CRON_SECRET=""

# Web push (order-ready notifications). Generate a key pair with: npm run vapid
# Leave all three empty to run without push; everything else still works.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact for push services, e.g. mailto:you@yourcollege.edu
VAPID_SUBJECT=""

# Password for the DEMO accounts created by `npm run db:seed` (8+ characters).
# Shown on the landing page only while the canteen is the demo canteen.
DEMO_PASSWORD=""
